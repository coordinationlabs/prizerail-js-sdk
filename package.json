{
  "name": "prizerail",
  "version": "1.0.0",
  "description": "The Prizerail SDK: send entries, read draws and verify them.",
  "license": "MIT",
  "homepage": "https://docs.prizerail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coordinationlabs/prizerail-js-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/coordinationlabs/prizerail-js-sdk/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "prizerail": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "keywords": [
    "prizerail",
    "sweepstakes",
    "prize draw",
    "pyth",
    "verifiable"
  ],
  "packageManager": "pnpm@10.18.3",
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
